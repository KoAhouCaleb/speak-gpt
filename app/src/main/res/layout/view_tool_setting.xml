<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/btn_accent_tonal_selector_v3"
    android:backgroundTint="@color/accent_250"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tool_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tool_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_subtitle"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tool_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:weightSum="3"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_disabled"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tool_mode_disabled" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_confirm"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tool_mode_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mode_auto"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tool_mode_auto" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
